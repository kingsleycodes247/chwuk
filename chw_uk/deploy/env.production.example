# Production settings. On the server copy this to /srv/chw/app/.env and fill in every value.
# chmod 600 /srv/chw/app/.env   — and NEVER commit the real file.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=PASTE_A_LONG_RANDOM_STRING
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

POSTGRES_DB=chw
POSTGRES_USER=chw
POSTGRES_PASSWORD=PASTE_A_DB_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Raise to 31536000 (1 year) once HTTPS works everywhere.
DJANGO_HSTS_SECONDS=3600
